#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define INF 1e9

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    // 1. Create a distance array initialized to infinity
    int* dist = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        dist[i] = INF;
    }
    dist[src] = 0; // Distance to origin is zero

    // 2. Run the relaxation pass exactly K + 1 times
    for (int i = 0; i <= k; i++) {
        // Create a backup snapshot of the distances from the previous round
        int* temp_dist = (int*)malloc(n * sizeof(int));
        memcpy(temp_dist, dist, n * sizeof(int));

        // Iterate through all flights (edges)
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0]; // From
            int v = flights[j][1]; // To
            int price = flights[j][2]; // Price

            // If node u was reachable in a previous step, try relaxing the edge
            if (dist[u] != INF) {
                if (dist[u] + price < temp_dist[v]) {
                    temp_dist[v] = dist[u] + price;
                }
            }
        }
        
        // Update the primary distance array with the results from this layer pass
        free(dist);
        dist = temp_dist;
    }

    int final_price = dist[dst];
    free(dist);

    return (final_price == INF) ? -1 : final_price;
}
