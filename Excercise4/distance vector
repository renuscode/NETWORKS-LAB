#include <stdio.h>
#include <stdbool.h>
#define INF 9999
#define MAX_NODES 10
struct RouteRow {
    int cost;
    int next_hop;
};
struct RoutingTable {
    struct RouteRow route[MAX_NODES];
};
int num_nodes;
int cost_matrix[MAX_NODES][MAX_NODES];
struct RoutingTable tables[MAX_NODES];
// Standard Bellman-Ford algorithm implementation to calculate all paths
bool run_bellman_ford() {
    for (int i = 0; i < num_nodes; i++) {
        for (int j = 0; j < num_nodes; j++) {
            tables[i].route[j].cost = (i == j) ? 0 : INF;
            tables[i].route[j].next_hop = -1;
        }
    }
    for (int source = 0; source < num_nodes; source++) {
        tables[source].route[source].cost = 0;
        for (int step = 1; step <= num_nodes - 1; step++) {
            for (int u = 0; u < num_nodes; u++) {
                for (int v = 0; v < num_nodes; v++) {
                    if (cost_matrix[u][v] != INF && tables[source].route[u].cost != INF) {
                        int current_calculated_cost = tables[source].route[u].cost + cost_matrix[u][v];
                        if (current_calculated_cost < tables[source].route[v].cost) {
                            tables[source].route[v].cost = current_calculated_cost;
                            if (u == source) {
                                tables[source].route[v].next_hop = v;
                            } else {
                                tables[source].route[v].next_hop = tables[source].route[u].next_hop;
                            }
                        }
                    }
                }
            }
        }
    }
    for (int source = 0; source < num_nodes; source++) {
        for (int u = 0; u < num_nodes; u++) {
            for (int v = 0; v < num_nodes; v++) {
                if (cost_matrix[u][v] != INF && tables[source].route[u].cost != INF) {
                    if (tables[source].route[u].cost + cost_matrix[u][v] < tables[source].route[v].cost) {
                        return false;
                    }
                }
            }
        }
    }
    return true;
}

// Displays a single targeted node's routing table with a formal grid
void display_single_node_table(int node_id) {
    printf("\n=============================================\n");
    printf("         ROUTING TABLE FOR NODE %d           \n", node_id);
    printf("=============================================\n");
    printf("  Destination  |     Cost     |   Next Hop   \n");
    printf("---------------------------------------------\n");
    for (int j = 0; j < num_nodes; j++) {
        printf("    Node %-5d | ", j);
        if (tables[node_id].route[j].cost == INF) {
            printf("    INF     | ");
        } else {
            printf("    %-7d | ", tables[node_id].route[j].cost);
        }
        if (node_id == j) {
            printf("Direct (Self)\n");
        } else if (tables[node_id].route[j].next_hop == -1) {
            printf("Unreachable\n");
        } else {
            printf("Node %-d\n", tables[node_id].route[j].next_hop);
        }
    }
    printf("=============================================\n");
}
void display_transposed_cost_matrix() {
    printf("\n======================================================\n");
    printf("       FINAL ROUTING TABLE            \n");
    printf("======================================================\n");

    printf("Dest \\ Src\t");
    for (int i = 0; i < num_nodes; i++) {
        printf("Src [%d]\t", i);
    }
    printf("\n------------------------------------------------------\n");

    for (int j = 0; j < num_nodes; j++) {
        printf("Dest [%d]\t|\t", j);
        for (int i = 0; i < num_nodes; i++) {
            if (tables[i].route[j].cost == INF) {
                printf("INF\t");
            } else {
                printf("%d\t", tables[i].route[j].cost);
            }
        }
        printf("\n");
    }
    printf("======================================================\n");
}

// NEW FUNCTION: Traces and prints the shortest path string and total cost
void trace_shortest_path() {
    int src, dest;
    printf("\n--- Shortest Path Routing Trace ---\n");
    printf("Enter Source Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &src) != 1) return;
    printf("Enter Destination Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &dest) != 1) return;

    if (src >= 0 && src < num_nodes && dest >= 0 && dest < num_nodes) {
        if (tables[src].route[dest].cost == INF) {
            printf("\nPath Status: No reachable connection path exists from Node %d to Node %d.\n", src, dest);
            printf("Total Cost: INF\n");
        } else {
            printf("\nOptimal Pathway: Node %d", src);
            int current = src;
            while (current != dest) {
                current = tables[current].route[dest].next_hop;
                printf(" -> Node %d", current);
            }
            printf("\nTotal Cost of Path: %d\n", tables[src].route[dest].cost);
        }
    } else {
        printf("Error: Input\n");
    }
}

// Submenu helper that asks the user if they want to modify costs dynamically
void ask_and_modify_cost() {
    int change_choice;
    printf("\nDo you want to change the cost of any node link? (1 for Yes, 0 for No): ");
    if (scanf("%d", &change_choice) != 1 || change_choice != 1) return;
    int src, dest, new_cost;
    printf("Enter Source Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &src) != 1) return;
    printf("Enter Destination Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &dest) != 1) return;
    printf("Enter New Link Cost (Use %d for INF): ", INF);
    if (scanf("%d", &new_cost) != 1) return;

    if (src >= 0 && src < num_nodes && dest >= 0 && dest < num_nodes) {
        if (src == dest) {
            printf("Error: Cost to self cannot be changed from 0 baseline.\n");
            return;
        }

        cost_matrix[src][dest] = new_cost;

        if (run_bellman_ford()) {
            printf("⚡ Matrix updated successfully!\n");
        } else {
            printf("🛑 Errr\n");
        }
    } else {
        printf("Error: Node parameters out of valid bounds.\n");
    }
}

int main() {
    printf("Enter number of network nodes : ");
    if (scanf("%d", &num_nodes) != 1 || num_nodes <= 0 || num_nodes > MAX_NODES) {
        printf("Invalid node capacity bound.\n");
        return 1;
    }

    printf("\nEnter the Adjacency Cost Matrix(Use %d for INF).\n", INF);
    for (int i = 0; i < num_nodes; i++) {
        printf("Row for Node %d: ", i);
        for (int j = 0; j < num_nodes; j++) {
            if (scanf("%d", &cost_matrix[i][j]) != 1) {
                printf("Invalid input error.\n");
                return 1;
            }
            if (i == j) {
                cost_matrix[i][j] = 0;
            }
        }
    }

    if (!run_bellman_ford()) {
        printf("\n🛑 Warnin\n");
        return 1;
    }
    int choice = 0;
    while (choice != 3) {
        printf("\n===== ROUTING DISPLAY OPTIONS =====\n");
        printf("1. Print as single Unified Final Matrix\n");
        printf("2. Print Structured Table for a specific Node\n");
        printf("3. Exit Program\n");
        printf("Enter your choice (1-3): ");
        if (scanf("%d", &choice) != 1) break;

        switch (choice) {
            case 1:
                display_transposed_cost_matrix();
                trace_shortest_path(); // Traces specific routes immediately after viewing
                ask_and_modify_cost();
                break;
            case 2: {
                int target_node;
                printf("Which Node's routing table would you like to display? (0-%d): ", num_nodes - 1);
                if (scanf("%d", &target_node) == 1) {
                    if (target_node >= 0 && target_node < num_nodes) {
                        display_single_node_table(target_node);
                        trace_shortest_path(); // Traces specific routes immediately after viewing
                        ask_and_modify_cost();
                    } else {
                        printf("Invalid Node ID selection!\n");
                    }
                }
                break;
            }
            case 3:
                printf("Exiting routing processing architecture. Goodbye.\n");
                break;
            default:
                printf("Invalid option selected. Choose 1, 2, or 3.\n");
        }
    }

    return 0;
}
