#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

#define INF 999999

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    // 1. Initialize the adjacency matrix layout with infinity (INF)
    // Nodes are 1-indexed, so we allocate size (n + 1)
    int adj[101][101];
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            adj[i][j] = (i == j) ? 0 : INF;
        }
    }

    // 2. Populate the adjacency matrix with the given directional times
    for (int i = 0; i < timesSize; i++) {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];
        adj[u][v] = w;
    }

    // 3. Setup tracking arrays for Dijkstra
    int dist[101];
    bool visited[101];
    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
        visited[i] = false;
    }
    
    // Distance to the source node itself is always 0
    dist[k] = 0;

    // 4. Run Dijkstra's Main Relaxation Loop
    for (int count = 0; count < n; count++) {
        int min_dist = INF;
        int u = -1;

        // Find the unvisited node with the minimum distance
        for (int v = 1; v <= n; v++) {
            if (!visited[v] && dist[v] < min_dist) {
                min_dist = dist[v];
                u = v;
            }
        }

        // If the minimum distance node is unreachable, the remaining nodes are also unreachable
        if (u == -1) break;
        visited[u] = true;

        // Relax all adjacent neighbors of node u
        for (int v = 1; v <= n; v++) {
            if (!visited[v] && adj[u][v] != INF) {
                if (dist[u] + adj[u][v] < dist[v]) {
                    dist[v] = dist[u] + adj[u][v];
                }
            }
        }
    }

    // 5. Find the maximum travel time among all nodes
    int max_delay = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            return -1; // Node i is completely unreachable from source k
        }
        if (dist[i] > max_delay) {
            max_delay = dist[i];
        }
    }

    return max_delay;
}
