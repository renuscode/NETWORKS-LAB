#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <math.h>

#define INF 10000000

// Structure to represent a cell position and the maximum effort to reach it
typedef struct {
    int r;
    int c;
    int effort;
} HeapNode;

// Min-Heap Structure
typedef struct {
    HeapNode* data;
    int size;
    int capacity;
} MinHeap;

// Helper functions for Min-Heap operations
MinHeap* createHeap(int capacity) {
    MinHeap* heap = (MinHeap*)malloc(sizeof(MinHeap));
    heap->data = (HeapNode*)malloc(capacity * sizeof(HeapNode));
    heap->size = 0;
    heap->capacity = capacity;
    return heap;
}

void swap(HeapNode* a, HeapNode* b) {
    HeapNode temp = *a;
    *a = *b;
    *b = temp;
}

void push(MinHeap* heap, int r, int c, int effort) {
    heap->data[heap->size].r = r;
    heap->data[heap->size].c = c;
    heap->data[heap->size].effort = effort;
    int i = heap->size;
    heap->size++;

    while (i > 0 && heap->data[i].effort < heap->data[(i - 1) / 2].effort) {
        swap(&heap->data[i], &heap->data[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

HeapNode pop(MinHeap* heap) {
    HeapNode minNode = heap->data[0];
    heap->size--;
    heap->data[0] = heap->data[heap->size];

    int i = 0;
    while (2 * i + 1 < heap->size) {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int smallest = left;

        if (right < heap->size && heap->data[right].effort < heap->data[left].effort) {
            smallest = right;
        }
        if (heap->data[i].effort <= heap->data[smallest].effort) {
            break;
        }
        swap(&heap->data[i], &heap->data[smallest]);
        i = smallest;
    }
    return minNode;
}

int minimumEffortPath(int** heights, int heightsSize, int* heightsColSize) {
    int rows = heightsSize;
    int cols = heightsColSize[0];

    // Direction vectors for moving up, down, left, right
    int dr[] = {-1, 1, 0, 0};
    int dc[] = {0, 0, -1, 1};

    // 2D Array to track minimum effort required to reach each cell
    int** effortGrid = (int**)malloc(rows * sizeof(int*));
    for (int i = 0; i < rows; i++) {
        effortGrid[i] = (int*)malloc(cols * sizeof(int));
        for (int j = 0; j < cols; j++) {
            effortGrid[i][j] = INF;
        }
    }

    // Initialize Min-Heap with maximum possible grid capacity
    MinHeap* heap = createHeap(rows * cols * 4);
    
    // Start at top-left corner
    effortGrid[0][0] = 0;
    push(heap, 0, 0, 0);

    while (heap->size > 0) {
        HeapNode curr = pop(heap);
        int r = curr.r;
        int c = curr.c;
        int currEffort = curr.effort;

        // If we reached the target destination cell, return the calculated effort
        if (r == rows - 1 && c == cols - 1) {
            int result = currEffort;
            // Memory clean up
            free(heap->data);
            free(heap);
            for (int i = 0; i < rows; i++) free(effortGrid[i]);
            free(effortGrid);
            return result;
        }

        // If we found a path with higher effort than already recorded, skip it
        if (currEffort > effortGrid[r][c]) continue;

        // Explore all 4 orthogonal neighboring cells
        for (int i = 0; i < 4; i++) {
            int nr = r + dr[i];
            int nc = c + dc[i];

            // Boundaries validation check
            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
                // Effort to move from (r,c) to (nr,nc) is the max bottleneck along the path
                int nextEffort = fmax(currEffort, abs(heights[r][c] - heights[nr][nc]));

                // If this path offers a lower effort transition, update and enqueue
                if (nextEffort < effortGrid[nr][nc]) {
                    effortGrid[nr][nc] = nextEffort;
                    push(heap, nr, nc, nextEffort);
                }
            }
        }
    }

    return 0;
}
