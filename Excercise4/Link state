#include <stdio.h>
#include <stdbool.h>
#define INF 9999
#define MAX_NODES 10
struct RouteRow {
    int cost;
    int next_hop;
};
struct RoutingTable {
    struct RouteRow route[MAX_NODES];
};
int num_nodes;
int cost_matrix[MAX_NODES][MAX_NODES];
struct RoutingTable tables[MAX_NODES];
// Global arrays for route rebuilding inside Dijkstra processing
int parent_map[MAX_NODES];
// Standard Centralized Link State Dijkstra Engine
void run_dijkstra() {
    // Run independently for every router in the network map
    for (int source = 0; source < num_nodes; source++) {
        int dist[MAX_NODES];
        bool visited[MAX_NODES];
        int local_parent[MAX_NODES];
        // 1. Initialization pass
        for (int i = 0; i < num_nodes; i++) {
            dist[i] = INF;
            visited[i] = false;
            local_parent[i] = -1;
        }
        dist[source] = 0;

        // 2. Main computation loop to locate minimum tentative paths
        for (int count = 0; count < num_nodes - 1; count++) {
            int min_distance = INF;
            int u = -1;

            // Extract minimum distance node from the unvisited set
            for (int v = 0; v < num_nodes; v++) {
                if (!visited[v] && dist[v] <= min_distance) {
                    min_distance = dist[v];
                    u = v;
                }
            }

            if (u == -1 || dist[u] == INF) break; // Remaining nodes are unreachable
            visited[u] = true;

            // Update/Relax neighbors of node u
            for (int v = 0; v < num_nodes; v++) {
                if (!visited[v] && cost_matrix[u][v] != INF && dist[u] != INF) {
                    if (dist[u] + cost_matrix[u][v] < dist[v]) {
                        dist[v] = dist[u] + cost_matrix[u][v];
                        local_parent[v] = u;
                    }
                }
            }
        }

        // 3. Populate Link-State Forwarding tables and determine Next Hops
        for (int dest = 0; dest < num_nodes; dest++) {
            tables[source].route[dest].cost = dist[dest];

            if (dest == source) {
                tables[source].route[dest].next_hop = -1;
            } else if (dist[dest] == INF) {
                tables[source].route[dest].next_hop = -1;
            } else {
                // Backtrack from destination to find the first step taken from source
                int curr = dest;
                while (local_parent[curr] != source && local_parent[curr] != -1) {
                    curr = local_parent[curr];
                }
                tables[source].route[dest].next_hop = curr;
            }
        }
    }
}

// Function to print standard standalone individual tables for each node
void display_single_node_table(int node_id) {
    printf("\n=============================================\n");
    printf("     LINK-STATE ROUTING TABLE FOR NODE %d    \n", node_id);
    printf("=============================================\n");
    printf("  Destination  |     Cost     |   Next Hop   \n");
    printf("---------------------------------------------\n");
    for (int j = 0; j < num_nodes; j++) {
        printf("    Node %-5d | ", j);

        if (tables[node_id].route[j].cost == INF) {
            printf("    INF     | ");
        } else {
            printf("    %-7d | ", tables[node_id].route[j].cost);
        }

        if (node_id == j) {
            printf("Direct (Self)\n");
        } else if (tables[node_id].route[j].next_hop == -1) {
            printf("Unreachable\n");
        } else {
            printf("Node %-d\n", tables[node_id].route[j].next_hop);
        }
    }
    printf("=============================================\n");
}

// Displays data as a global Cost Matrix where Source = Columns and Dest = Rows
void display_transposed_cost_matrix() {
    printf("\n======================================================\n");
    printf("       LINK-STATE              \n");
    printf("======================================================\n");

    printf("Dest \\ Src\t");
    for (int i = 0; i < num_nodes; i++) {
        printf("Src [%d]\t", i);
    }
    printf("\n------------------------------------------------------\n");

    for (int j = 0; j < num_nodes; j++) {
        printf("Dest [%d]\t|\t", j);
        for (int i = 0; i < num_nodes; i++) {
            if (tables[i].route[j].cost == INF) {
                printf("INF\t");
            } else {
                printf("%d\t", tables[i].route[j].cost);
            }
        }
        printf("\n");
    }
    printf("======================================================\n");
}

// Traces and prints the shortest path string and total cost
void trace_shortest_path() {
    int src, dest;
    printf("Enter Source Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &src) != 1) return;
    printf("Enter Destination Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &dest) != 1) return;
    if (src >= 0 && src < num_nodes && dest >= 0 && dest < num_nodes) {
        if (tables[src].route[dest].cost == INF) {
            printf("\nPath Status: No reachable link connection path exists.\n");
        } else {
            printf("\nOptimal Link State Path: Node %d", src);
            int current = src;
            while (current != dest) {
                current = tables[current].route[dest].next_hop;
                printf(" -> Node %d", current);
            }
            printf("\nTotal Dijkstra Path Cost: %d\n", tables[src].route[dest].cost);
        }
    } else {
        printf("Error.\n");
    }
}

// Submenu helper that asks the user if they want to modify costs dynamically
void ask_and_modify_cost() {
    int change_choice;
    printf("\nDo you want to change any link cost? (1 for Yes, 0 for No): ");
    if (scanf("%d", &change_choice) != 1 || change_choice != 1) return;

    int src, dest, new_cost;
    printf("Enter Source Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &src) != 1) return;
    printf("Enter Destination Node (0-%d): ", num_nodes - 1);
    if (scanf("%d", &dest) != 1) return;
    printf("Enter New Link Cost (Use %d for INF): ", INF);
    if (scanf("%d", &new_cost) != 1) return;

    if (src >= 0 && src < num_nodes && dest >= 0 && dest < num_nodes) {
        if (src == dest) {
            printf("Error: Cost to self cannot be changed from 0 baseline.\n");
            return;
        }

        cost_matrix[src][dest] = new_cost;
        printf("\nRecalculating routing layout using Dijkstra's Algorithm...\n");
        run_dijkstra();
        printf("⚡ Network layout updated successfully!\n");
    } else {
        printf("Error: Node parameters out of valid bounds.\n");
    }
}

int main() {
    printf("Enter number of network nodes (Max %d): ", MAX_NODES);
    if (scanf("%d", &num_nodes) != 1 || num_nodes <= 0 || num_nodes > MAX_NODES) {
        printf("Invalid node capacity bound.\n");
        return 1;
    }

    printf("\nEnter the Adjacency Cost Matrix r (Use %d for INF).\n", INF);
    printf("Example for a 3-node row format: 0 2 7\n\n");

    for (int i = 0; i < num_nodes; i++) {
        printf("Row for Node %d: ", i);
        for (int j = 0; j < num_nodes; j++) {
            if (scanf("%d", &cost_matrix[i][j]) != 1) {
                printf("Invalid input error.\n");
                return 1;
            }
            if (i == j) {
                cost_matrix[i][j] = 0;
            }
        }
    }

    // Run Dijkstra computation
    run_dijkstra();
    printf("\n Dijkstra link state conversion complete.\n");

    int choice = 0;
    while (choice != 3) {
        printf("\n===== LINK STATE DISPLAY OPTIONS =====\n");
        printf("1. Print as single Unified Cost Matrix\n");
        printf("2. Print Structured Table for a specific Node\n");
        printf("3. Exit Program\n");
        printf("Enter your choice (1-3): ");
        if (scanf("%d", &choice) != 1) break;

        switch (choice) {
            case 1:
                display_transposed_cost_matrix();
                trace_shortest_path();
                ask_and_modify_cost();
                break;
            case 2: {
                int target_node;
                printf("Which Node's link state table would you like to display? (0-%d): ", num_nodes - 1);
                if (scanf("%d", &target_node) == 1) {
                    if (target_node >= 0 && target_node < num_nodes) {
                        display_single_node_table(target_node);
                        trace_shortest_path();
                        ask_and_modify_cost();
                    } else {
                        printf("Invalid Node ID selection!\n");
                    }
                }
                break;
            }
            case 3:
                printf("Powering down link-state simulator framework.\n");
                break;
            default:
                printf("Invalid selection index. Try again.\n");
        }
    }

    return 0;
}
