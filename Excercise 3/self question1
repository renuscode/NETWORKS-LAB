#include <stdio.h>
#include <string.h>

int main() {
    char data[100];
    int m, r = 0;
    int code[150];
    int i, j, pos;
    int syndrome = 0;

    printf("Enter binary data: ");
    scanf("%s", data);

    m = strlen(data);

    // Find number of parity bits
    while ((1 << r) < (m + r + 1))
        r++;

    int n = m + r;

    // Initialize code array
    for (i = 1; i <= n; i++)
        code[i] = 0;

    // Place data bits
    j = 0;
    for (i = 1; i <= n; i++) {
        if ((i & (i - 1)) != 0) {
            code[i] = data[j++] - '0';
        }
    }

    // Calculate parity bits
    for (i = 0; i < r; i++) {
        int p = 1 << i;
        int parity = 0;

        for (j = 1; j <= n; j++) {
            if ((j & p) && j != p)
                parity ^= code[j];
        }

        code[p] = parity;
    }

    printf("\nNumber of data bits     : %d", m);
    printf("\nNumber of parity bits   : %d", r);
    printf("\nTotal Hamming bits      : %d", n);

    printf("\n\nGenerated Hamming Code: ");
    for (i = n; i >= 1; i--)
        printf("%d", code[i]);

    // Error simulation
    printf("\n\nEnter error position (1-%d, 0 for no error): ", n);
    scanf("%d", &pos);

    if (pos != 0) {
        code[pos] ^= 1;
        printf("\nError introduced at position: %d", pos);

        printf("\nReceived Hamming Code: ");
        for (i = n; i >= 1; i--)
            printf("%d", code[i]);
    } else {
        printf("\nNo error introduced.");
    }

    // Calculate syndrome
    syndrome = 0;

    for (i = 0; i < r; i++) {
        int p = 1 << i;
        int parity = 0;

        for (j = 1; j <= n; j++) {
            if (j & p)
                parity ^= code[j];
        }

        if (parity)
            syndrome += p;
    }

    printf("\n\nSyndrome = %d", syndrome);

    if (syndrome == 0) {
        printf("\nNo error detected.");
    } else {
        printf("\nError detected at position: %d", syndrome);

        // Correct error
        code[syndrome] ^= 1;

        printf("\nError corrected successfully.");
    }

    // Display corrected code
    printf("\n\nCorrected Hamming Code: ");
    for (i = n; i >= 1; i--)
        printf("%d", code[i]);

    // Extract original data
    printf("\nRecovered Data: ");

    for (i = n; i >= 1; i--) {
        if ((i & (i - 1)) != 0)
            printf("%d", code[i]);
    }

    printf("\n");

    return 0;
}
