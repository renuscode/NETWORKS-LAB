#include <stdio.h>
#include <string.h>

int main() {
    char data[100];
    int m, r = 0;
    int code[150];
    int i, j;
    int errorType;
    int pos1, pos2;
    int syndrome = 0;
    int overallParity = 0;

    printf("Enter binary data: ");
    scanf("%s", data);

    m = strlen(data);

    // Find number of Hamming parity bits
    while ((1 << r) < (m + r + 1))
        r++;

    int n = m + r;       // Hamming code length
    int total = n + 1;   // Extra overall parity bit

    // Initialize
    for (i = 0; i <= total; i++)
        code[i] = 0;

    // Place data bits
    j = 0;

    for (i = 1; i <= n; i++) {
        if ((i & (i - 1)) != 0) {
            code[i] = data[j++] - '0';
        }
    }

    // Calculate Hamming parity bits
    for (i = 0; i < r; i++) {
        int p = 1 << i;
        int parity = 0;

        for (j = 1; j <= n; j++) {
            if ((j & p) && j != p)
                parity ^= code[j];
        }

        code[p] = parity;
    }

    // Calculate overall parity
    for (i = 1; i <= n; i++)
        overallParity ^= code[i];

    code[total] = overallParity;

    // Display generated code
    printf("\nGenerated SECDED Code: ");

    for (i = total; i >= 1; i--)
        printf("%d", code[i]);

    printf("\n");

    // Error simulation
    printf("\nSelect error type:");
    printf("\n1. No Error");
    printf("\n2. Single-bit Error");
    printf("\n3. Double-bit Error");
    printf("\nEnter choice: ");
    scanf("%d", &errorType);

    if (errorType == 1) {

        printf("\nNo error introduced.");

    }
    else if (errorType == 2) {

        printf("\nEnter error position (1-%d): ", total);
        scanf("%d", &pos1);

        code[pos1] ^= 1;

        printf("\nSingle-bit error introduced at position: %d", pos1);

    }
    else if (errorType == 3) {

        printf("\nEnter first error position (1-%d): ", total);
        scanf("%d", &pos1);

        printf("Enter second error position (1-%d): ", total);
        scanf("%d", &pos2);

        if (pos1 == pos2) {
            printf("\nError positions must be different.");
            return 0;
        }

        code[pos1] ^= 1;
        code[pos2] ^= 1;

        printf("\nDouble-bit error introduced at positions: %d and %d",
               pos1, pos2);
    }

    // Display received code
    printf("\n\nReceived SECDED Code: ");

    for (i = total; i >= 1; i--)
        printf("%d", code[i]);

    // Calculate syndrome
    syndrome = 0;

    for (i = 0; i < r; i++) {
        int p = 1 << i;
        int parity = 0;

        for (j = 1; j <= n; j++) {
            if (j & p)
                parity ^= code[j];
        }

        if (parity)
            syndrome += p;
    }

    // Calculate overall parity
    overallParity = 0;

    for (i = 1; i <= total; i++)
        overallParity ^= code[i];

    printf("\n\nSyndrome = %d", syndrome);
    printf("\nOverall Parity = %d", overallParity);

    // SECDED decision
    if (syndrome == 0 && overallParity == 0) {

        printf("\nStatus: NO ERROR");
        printf("\nFrame received correctly.");

    }
    else if (syndrome != 0 && overallParity == 1) {

        printf("\nStatus: SINGLE-BIT ERROR");
        printf("\nError detected at position: %d", syndrome);

        code[syndrome] ^= 1;

        printf("\nSingle-bit error CORRECTED.");

    }
    else if (syndrome == 0 && overallParity == 1) {

        printf("\nStatus: ERROR IN OVERALL PARITY BIT");

        code[total] ^= 1;

        printf("\nOverall parity bit corrected.");

    }
    else if (syndrome != 0 && overallParity == 0) {

        printf("\nStatus: DOUBLE-BIT ERROR DETECTED.");
        printf("\nDouble-bit error CANNOT be corrected.");
    }

    // Display final code
    printf("\n\nFinal Code: ");

    for (i = total; i >= 1; i--)
        printf("%d", code[i]);

    // Recover data only if no uncorrectable error
    if (!(syndrome != 0 && overallParity == 0)) {

        printf("\nRecovered Data: ");

        for (i = n; i >= 1; i--) {
            if ((i & (i - 1)) != 0)
                printf("%d", code[i]);
        }
    }

    printf("\n");

    return 0;
}
