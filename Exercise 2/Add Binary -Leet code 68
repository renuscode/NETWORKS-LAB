#include <stdlib.h>
#include <string.h>

char* addBinary(char* a, char* b) {
    int lenA = strlen(a);
    int lenB = strlen(b);
    
    // Max possible length is max(lenA, lenB) + 1 for a potential carry
    int maxLen = (lenA > lenB ? lenA : lenB) + 1;
    
    // Allocate memory for the result string plus the null terminator
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    if (!result) return NULL;
    
    result[maxLen] = '\0';
    
    int i = lenA - 1;
    int j = lenB - 1;
    int k = maxLen - 1;
    int carry = 0;
    
    // Process strings from right to left
    while (i >= 0 || j >= 0 || carry > 0) {
        int sum = carry;
        
        if (i >= 0) {
            sum += a[i] - '0';
            i--;
        }
        if (j >= 0) {
            sum += b[j] - '0';
            j--;
        }
        
        carry = sum / 2;
        result[k] = (sum % 2) + '0';
        k--;
    }
    
    // If the leading character wasn't used, shift the string forward
    if (k >= 0) {
        memmove(result, &result[k + 1], maxLen - k);
    }
    
    return result;
}
